# Consumer SPA environment variables
# Copy to .env.local and fill in values from CDK outputs

# API Gateway base URL (from CDK output: ApiStack.HttpApiUrl)
VITE_API_URL=https://xxxxxxxxxx.execute-api.eu-west-2.amazonaws.com

# Cognito User Pool ID (from CDK output: AuthStack.UserPoolId)
VITE_USER_POOL_ID=eu-west-2_XXXXXXXXX

# Cognito Consumer App Client ID (from CDK output: AuthStack.ConsumerClientId)
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
